---
import { url } from '../../data/urls.js';
import Base from '../../layouts/Base.astro';
import PRODUCTS from '../../data/products.js';
import { CATEGORIES } from '../../data/company.js';
import ProductCard from '../../components/ProductCard.astro';
---

<Base title="المنتجات" description="كتالوج كامل للرخام والجرانيت والترافرتينو.">
  <section>
    <div class="wrap">
      <div class="crumbs"><a href={url('/')}>الرئيسية</a> / المنتجات</div>
      <h1 class="sec-title">المنتجات</h1>
      <p class="sec-sub">{PRODUCTS.length} منتجاً. اختر التصنيف لتضييق النتائج.</p>
      <div class="tabs">
        <a href={url("/products/all")} class="tab active">الكل ({PRODUCTS.length})</a>
        {CATEGORIES.map((c) => (
          <a href={url(`/products/${c.slug}`)} class="tab">{c.name}</a>
        ))}
      </div>
      <div class="grid">
        {PRODUCTS.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>
</Base>