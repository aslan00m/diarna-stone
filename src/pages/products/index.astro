---
import { url } from '../../data/urls.js';
import Base from '../../layouts/Base.astro';
import PRODUCTS from '../../data/products.js';
import { CATEGORIES } from '../../data/company.js';
import ProductCard from '../../components/ProductCard.astro';

// ترتيب الصفحة يتحكم به علم `featured` على المنتج نفسه، لا موضعه في المصفوفة.
// بهذا يظهر المنتج المُضاف لاحقاً في المقدمة — وهو المطلوب.
//
//   featured: 2 = إضافة المالك الجديدة: مقدمة الصفحة + الأكثر طلباً + المميزة + الرئيسية
//   featured: 1 = اختيارات راسخة (الأكثر طلباً في المدينة)
//   غائب أو 0  = موضعه الطبيعي في الكتالوج

// أسماء العرض المخصّصة لبعض الأحجار (ما يسمّيه العميل في السوق)
const DISPLAY_NAMES = {
  'crema-marfil-classic': 'حجر الرياض الطبيعي (كريما مارفيل)',
  'bianco-carrara-marble': 'حجر الرياض الأبيض (بيانكو كرارة)',
  'roman-travertine-classic': 'رخام ترافرتين روماني',
  'emperador-light-marble': 'الرخام العماني (إمبرادور لايت)',
  'basalt-dark': 'بازلت المدينة',
  'mugla-bianco-classic': 'رخام موغلا التركي',
  'calacatta-marble': 'رخام كالاكاتا الإيطالي',
  'statuario-marble': 'رخام ستاتواريو الإيطالي',
};
const withDisplayName = (p) =>
  DISPLAY_NAMES[p.slug] ? { ...p, name: DISPLAY_NAMES[p.slug] } : p;

const newArrivals = PRODUCTS.filter((p) => p.featured >= 2).map(withDisplayName);
const medinaTop = PRODUCTS.filter((p) => p.featured >= 1).map(withDisplayName);

import { graph, breadcrumb } from '../../data/schema.js';

const schemaJson = graph([
  breadcrumb([
    { name: 'الرئيسية', path: '/' },
    { name: 'المنتجات', path: '/products' },
  ]),
]);
---

<Base
  title="المنتجات"
  description="كتالوج كامل للرخام والجرانيت والترافرتينو."
  canonical="/products"
  schema={schemaJson}
>
  <section>
    <div class="wrap">
      <div class="crumbs"><a href={url('/')}>الرئيسية</a> / المنتجات</div>
      <h1 class="sec-title">المنتجات</h1>
      <p class="sec-sub">{PRODUCTS.length} منتجاً. اختر التصنيف لتضييق النتائج.</p>
      <div class="tabs">
        <a href={url("/products/all")} class="tab active">الكل ({PRODUCTS.length})</a>
        {CATEGORIES.map((c) => (
          <a href={url(`/products/${c.slug}`)} class="tab">{c.name}</a>
        ))}
      </div>
    </div>
  </section>

  {newArrivals.length > 0 && (
    <!-- إضافات جديدة -->
    <section>
      <div class="wrap">
        <h2 class="sec-title" data-anim="up">إضافات جديدة</h2>
        <p class="sec-sub">أحدث الأحجار التي أضافها المعرض.</p>
        <div class="grid" data-stagger>
          {newArrivals.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- الأكثر طلباً في المدينة المنورة -->
  <section>
    <div class="wrap">
      <h2 class="sec-title" data-anim="up">الأكثر طلباً في المدينة المنورة</h2>
      <p class="sec-sub">الأحجار الطبيعية الأكثر بيعًا واستخدامًا في واجهات المباني بالمدينة المنورة.</p>
      <div class="grid" data-stagger>
        {medinaTop.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- كل المنتجات -->
  <section>
    <div class="wrap">
      <h2 class="sec-title">كل المنتجات</h2>
      <div class="grid">
        {PRODUCTS.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>
</Base>
