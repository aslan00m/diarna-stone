---
import { url } from '../../data/urls.js';
import Base from '../../layouts/Base.astro';
import PRODUCTS from '../../data/products.js';
import { CATEGORIES, ORIGINS } from '../../data/company.js';
import ProductCard from '../../components/ProductCard.astro';
import FamilyCard from '../../components/FamilyCard.astro';
import FAMILIES from '../../data/families.js';
import { CATEGORY_INTRO } from '../../data/category-intro.js';

export function getStaticPaths() {
  return [
    { params: { cat: 'all' }, props: { cat: 'all' } },
    ...CATEGORIES.map((c) => ({ params: { cat: c.slug }, props: { cat: c.slug } })),
  ];
}

const { cat } = Astro.props;
// Cards, not raw products: several of our products are grades of one stone (a family),
// and they share one photo. Showing a card per family with the types listed inside it
// removes the repeated-photo grid while every type keeps its own page and URL.
const cards = cat === 'all' ? FAMILIES : FAMILIES.filter((c) => c.cat === cat);
const inCat = cat === 'all' ? PRODUCTS : PRODUCTS.filter((p) => p.category === cat);
const filtered = inCat;
const catName = cat === 'all' ? 'كل المنتجات' : CATEGORIES.find((c) => c.slug === cat)?.name;
const intro = cat === 'all' ? null : CATEGORY_INTRO[cat];
const typeCount = cards.reduce((n, c) => n + c.count, 0);
---

<Base title={`${catName} — المنتجات`} description={`تصفح ${catName} من ${filtered.length} منتجاً في متجر ديارنا الحديثة للحجر الطبيعي.`}>
  <section>
    <div class="wrap">
      <div class="crumbs"><a href={url("/")}>الرئيسية</a> / <a href={url("/products")}>المنتجات</a> / {catName}</div>
      <h1 class="sec-title">{catName}</h1>
      <p class="sec-sub">{filtered.length} منتجاً متاحاً — اختر نوع الحجر المناسب لمشروعك.</p>

      {intro && (
        <div class="cat-intro">
          <p class="lead">{intro.lead}</p>
          {intro.body.map((para) => <p>{para}</p>)}
          <div class="buy-box">
            <h3>نصائح قبل الشراء</h3>
            <ul>
              {intro.buying.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
      )}

      <!-- تصفية حسب النوع -->
      <div class="tabs">
        <a href={url("/products")} class={`tab ${cat === 'all' ? 'active' : ''}`}>الكل ({PRODUCTS.length})</a>
        {CATEGORIES.map((c) => {
          const n = PRODUCTS.filter((p) => p.category === c.slug).length;
          return (
            <a href={url(`/products/${c.slug}`)} class={`tab ${cat === c.slug ? 'active' : ''}`}>
              {c.name} ({n})
            </a>
          );
        })}
      </div>

      <!-- تصفية حسب المصدر (روابط) -->
      <div class="tabs" style="margin-bottom:34px">
        <span style="color:var(--muted);font-size:.9rem;align-self:center">حسب المصدر:</span>
        {ORIGINS.map((o) => {
          const n = filtered.filter((p) => p.origin === o.slug).length;
          return n > 0 && (
            <a href={url(`/products/${cat}`)} class="tab">
              {o.flag} {o.name} ({n})
            </a>
          );
        })}
      </div>

      {
        cards.length === 0 ? (
          <p style="color:var(--muted)">لا توجد منتجات في هذا التصنيف حالياً.</p>
        ) : (
          <>
            <p class="sec-sub" style="margin-bottom:22px">
              {cards.length} حجراً · {typeCount} نوعاً — بعض الأحجار لها عدة أنواع، اضغط على «عرض الأنواع» لرؤية درجاتها اللونية.
            </p>
            <div class="grid">
              {cards.map((c) => {
                const p = PRODUCTS.find((x) => x.slug === c.slug);
                return <FamilyCard product={p} family={c} />;
              })}
            </div>
          </>
        )
      }

      <div class="cta">
        <h3>لم تجد الحجر المناسب؟</h3>
        <p>نتعامل مع موردين متعددين — أرسل لنا طلبك وسنبحث لك عن الخامة.</p>
        <a href={url("/contact")} class="btn">أرسل طلبك</a>
      </div>
    </div>
  </section>
</Base>