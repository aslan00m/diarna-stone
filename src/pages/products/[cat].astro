---
import { url } from '../../data/urls.js';
import Base from '../../layouts/Base.astro';
import PRODUCTS from '../../data/products.js';
import STONES from '../../data/families.js';
import GALLERY from '../../data/sink-gallery.js';
import ProductCard from '../../components/ProductCard.astro';
import { CATEGORIES, ORIGINS } from '../../data/company.js';
import FamilyCard from '../../components/FamilyCard.astro';
import { CATEGORY_INTRO } from '../../data/category-intro.js';

export function getStaticPaths() {
  return [
    { params: { cat: 'all' }, props: { cat: 'all' } },
    ...CATEGORIES.map((c) => ({ params: { cat: c.slug }, props: { cat: c.slug } })),
  ];
}

const { cat } = Astro.props;

// الأحجار الأكثر طلباً في المدينة المنورة — تظهر أولاً في صفحة "كل المنتجات"
const MEDINA_TOP_SLUGS = [
  'crema-marfil-classic',       // حجر الرياض الطبيعي (الأكثر استخداماً)
  'bianco-carrara-marble',       // حجر الرياض الأبيض
  'roman-travertine-classic',    // رخام ترافرتين
  'emperador-light-marble',      // الرخام العماني
  'basalt-dark',                 // بازلت المدينة
  'mugla-bianco-classic',        // رخام تركي (موغلا)
  'calacatta-marble',            // رخام إيطالي (كرارا/كالاكاتا)
  'statuario-marble',            // رخام إيطالي (ستاتواريو)
];
const medinaTop = MEDINA_TOP_SLUGS
  .map((slug) => PRODUCTS.find((p) => p.slug === slug))
  .filter(Boolean);

// Sinks are not one product per item: the catalogue carries six specification entries
// while the photo gallery holds 37 vanities of our own work. A visitor opening
// /products/sinks expects to see everything we sell, so both are listed here — the
// gallery cards first because a photo answers "what does it look like" before a spec
// table does. One card per stone everywhere else; sinks are the exception.
const gallery = cat === 'sinks' || cat === 'all' ? GALLERY : [];
const cards = cat === 'all' ? STONES : STONES.filter((c) => c.cat === cat);
const catName = cat === 'all' ? 'كل الأحجار' : CATEGORIES.find((c) => c.slug === cat)?.name;
const intro = cat === 'all' ? null : CATEGORY_INTRO[cat];
const gradeCount = cards.reduce((n, c) => n + c.count, 0);
const multiCount = cards.filter((c) => c.multi).length;
const sinkProducts = PRODUCTS.filter((p) => p.category === 'sinks');
const sinkPhotos = gallery.reduce((n, g) => n + g.count, 0);
---

<Base
  title={cat === 'sinks'
    ? `المغاسل الحجرية — ${gallery.length} نموذجاً | ديارنا`
    : `${catName} — ${cards.length} حجر`}
  description={cat === 'sinks'
    ? `${gallery.length} مغسلة حجرية نفّذناها — ${sinkPhotos} صورة حقيقية، مع المواصفات والمقاسات والخامات.`
    : `تصفح ${cards.length} حجراً (${gradeCount} درجة) في متجر ديارنا الحديثة للحجر الطبيعي.`}
>
  <section>
    <div class="wrap">
      <div class="crumbs"><a href={url("/")}>الرئيسية</a> / <a href={url("/products")}>المنتجات</a> / {catName}</div>
      <h1 class="sec-title">{cat === 'sinks' ? 'المغاسل الحجرية' : catName}</h1>
      <p class="sec-sub">
        {cat === 'sinks'
          ? `${gallery.length} نموذجاً · ${sinkPhotos} صورة حقيقية · ${sinkProducts.length} نموذج مواصفات — اختر ما يناسب حمامك.`
          : `${cards.length} حجراً · ${gradeCount} درجة — اختر الحجر المناسب لمشروعك.`}
      </p>

      {intro && (
        <div class="cat-intro">
          <p class="lead">{intro.lead}</p>
          {intro.body.map((para) => <p>{para}</p>)}
          <div class="buy-box">
            <h3>نصائح قبل الشراء</h3>
            <ul>
              {intro.buying.map((t) => <li>{t}</li>)}
            </ul>
          </div>
        </div>
      )}

      <!-- تصفية حسب النوع -->
      <div class="tabs">
        <a href={url("/products")} class={`tab ${cat === 'all' ? 'active' : ''}`}>
          الكل ({cat === 'all' ? cards.length : cat === 'sinks'
            ? GALLERY.length + sinkProducts.length
            : cards.length})
        </a>
        {CATEGORIES.map((c) => {
          // Sinks are listed as 37 gallery vanities plus 6 spec entries, so counting
          // PRODUCTS alone understated the tab as "المغاسل (6)" while the page showed 43
          // cards. Every other category is one card per stone, which STONES reflects.
          // count on the same basis as the page being rendered, otherwise the tab
          // says 44 marble while 30 cards are listed
          const n = c.slug === 'sinks'
            ? GALLERY.length + sinkProducts.length
            : STONES.filter((st) => st.cat === c.slug).length;
          return (
            <a href={url(`/products/${c.slug}`)} class={`tab ${cat === c.slug ? 'active' : ''}`}>
              {c.name} ({n})
            </a>
          );
        })}
      </div>

      <!-- الأكثر طلباً في المدينة المنورة — يظهر فقط في صفحة "كل المنتجات" -->
      {cat === 'all' && medinaTop.length > 0 && (
        <>
          <h2 class="sec-title" style="margin-top:40px">الأكثر طلباً في المدينة المنورة</h2>
          <p class="sec-sub">الأحجار الطبيعية الأكثر بيعًا واستخدامًا في واجهات المباني بالمدينة المنورة.</p>
          <div class="grid" style="margin-bottom:40px">
            {medinaTop.map((p) => <ProductCard product={p} />)}
          </div>
          <h2 class="sec-title">كل المنتجات</h2>
        </>
      )}

      {
        cat === 'sinks' ? (
          <>
            <h2 class="sec-title">نماذج من أعمالنا</h2>
            <p class="sec-sub" style="margin-bottom:22px">
              {gallery.length} مغسلة نفّذناها — اضغط على أي نموذج لعرض كل صوره.
            </p>
            <div class="grid" style="margin-bottom:46px">
              {gallery.map((g) => (
                <a class="card" href={url(`/sinks-gallery/${g.slug}`)}>
                  <div style="aspect-ratio:4/3;overflow:hidden">
                    <img
                      src={url(g.photos[0])}
                      alt={`مغسلة حجرية ${g.name} — ${g.description_ar}`}
                      style="width:100%;height:100%;object-fit:cover;display:block"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="card-body">
                    <h3>{g.name}</h3>
                    <div class="meta">{g.description_ar}</div>
                    {g.count > 1 && (
                      <span class="badge">{g.count} صور</span>
                    )}
                  </div>
                </a>
              ))}
            </div>

            <h2 class="sec-title">مواصفات المغاسل</h2>
            <p class="sec-sub" style="margin-bottom:22px">
              المقاسات والخامات والتشطيبات — لكل نوع مواصفاته.
            </p>
            <div class="grid">
              {sinkProducts.map((p) => <ProductCard product={p} />)}
            </div>
          </>
        ) : cards.length === 0 ? (
          <p style="color:var(--muted)">لا توجد منتجات في هذا التصنيف حالياً.</p>
        ) : (
          <>
            <p class="sec-sub" style="margin-bottom:22px">
              {cards.length} حجراً · {gradeCount} درجة — الأحجار التي لها أكثر من درجة تقودك إلى صفحتها لعرض كل الدرجات وألوانها.
            </p>
            <div class="grid">
              {cards.map((c) => {
                const p = PRODUCTS.find((x) => x.slug === c.slug);
                return <FamilyCard product={p} family={c} />;
              })}
            </div>
          </>
        )
      }

      <div class="cta">
        <h3>لم تجد الحجر المناسب؟</h3>
        <p>نتعامل مع موردين متعددين — أرسل لنا طلبك وسنبحث لك عن الخامة.</p>
        <a href={url("/contact")} class="btn">أرسل طلبك</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .badge {
    display: inline-block;
    margin-top: 8px;
    background: #f1f5f9;
    color: #334155;
    border-radius: 999px;
    padding: 3px 11px;
    font-size: .76rem;
  }
</style>
