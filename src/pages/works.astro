---
import Base from '../layouts/Base.astro';
import PROJECTS from '../data/projects-full.js';
import MATERIALS from '../data/materials.js';
import OUR_WORKS from '../data/our-works.js';
import { url } from '../data/urls.js';
import { COMPANY, LINKS } from '../data/company.js';

const byCat = PROJECTS.reduce((acc, p) => {
  (acc[p.category] ||= []).push(p);
  return acc;
}, {});
---

<Base
  title={`مشاريعنا | ${COMPANY.name}`}
  description="مشاريع حقيقية نفّذتها ديارنا الحديثة: واجهات خارجية، ترميم، تشطيب داخلي، ومشاريع تحت التنفيذ — لكل مشروع صفحته بصوره ومراحله."
>
  <section class="page-hero">
    <div class="wrap">
      <h1>مشاريعنا</h1>
      <p>
        مشاريع نفّذتها {COMPANY.name} فعلياً — واجهات خارجية، ترميم، وتشطيب داخلي.
        كل مشروع له صفحته الخاصة بصوره ومراحله (قبل وأثناء وبعد) وشرح العمل الذي قمنا عليه.
      </p>
    </div>
  </section>

  <section>
    <div class="wrap">
      {
        PROJECTS.length === 0 ? (
          <div class="cta-band">
            <h2>المشاريع قيد الإضافة</h2>
            <p>ننشر مشاريعنا مع صور المراحل الفعلية — تابعنا قريباً.</p>
          </div>
        ) : Object.entries(byCat).map(([cat, list]) => (
          <div class="cat-block">
            <h2 class="sec-title">{cat}</h2>
            <div class="work-grid">
              {list.map((pr) => {
                const imgs = pr.stages.flatMap((s) => s.images);
                return (
                  <a href={url(`/works/${pr.slug}`)} class="work-item">
                    <span class="shot"><img src={url(pr.cover)} alt={pr.coverAlt} loading="lazy" decoding="async" /></span>
                    <figcaption>
                      <span class="work-t">{pr.title}</span>
                      <span class="work-tag">
                        {imgs.length} صورة
                        {pr.stages.length > 1 &&
                          ` · ${pr.stages.map((s) => s.label).join(' ← ')}`}
                      </span>
                    </figcaption>
                  </a>
                );
              })}
            </div>
          </div>
        ))
      }

      <div class="cat-block">
        <h2 class="sec-title">مشاريعنا</h2>
        <p class="sec-sub">
          واجهات نفّذناها ونتولى صيانتها — تشطيبات كاملة من الأساس حتى التسليم.
        </p>
        <div class="work-grid">
          {OUR_WORKS.map((m) => (
            <figure class="work-item">
              <span class="shot"><img src={url(m.src)} alt={m.alt} loading="lazy" decoding="async" /></span>
              <figcaption>
                <span class="work-t">{m.title}</span>
                <span class="work-tag">واجهات خارجية</span>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>

      <div class="cat-block">
        <h2 class="sec-title">الخامات والمواد</h2>
        <p class="sec-sub">
          كتل وألواح حجرية في مخزننا وورشتنا، قبل القص والتشطيب النهائي.
          صور حقيقية للمواد كما تصل.
        </p>
        <div class="work-grid">
          {
            MATERIALS.map((m) => (
              <figure class="work-item">
                <span class="shot"><img src={url(m.src)} alt={m.alt} loading="lazy" decoding="async" /></span>
                <figcaption>
                  <span class="work-t">{m.title}</span>
                  <span class="work-tag">{m.tag}</span>
                </figcaption>
              </figure>
            ))
          }
        </div>
      </div>

      <div class="cta-band">
        <h2>مشروعك القادم قد يكون هنا</h2>
        <p>أرسل لنا نوع الحجر والتشطيب المطلوب، ونرجع لك بعرض سعر واضح.</p>
        <div class="cta-row">
          <a href={url('/contact')} class="btn">طلب عرض سعر</a>
          <a href={LINKS.whatsapp} class="btn ghost">تواصل واتساب</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .cat-block { margin-bottom: 58px; }
  .work-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 18px;
    margin-top: 18px;
  }
  /* عمودان على الجوال — قاعدة نهائية تمنع الرجوع لعمود واحد */
  @media (max-width: 900px) {
    .work-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 12px; }
  }
  .work-item {
    margin: 0;
    display: block;
    text-decoration: none;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    overflow: hidden;
    transition: transform .18s, box-shadow .18s;
  }
  .work-item:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 26px rgba(20, 20, 15, .08);
  }
  /* الصورة بنسبة ثابتة وقص: كل بطاقة بنفس الارتفاع مهما اختلفت الصورة */
  .work-item .shot {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #f3f1ec;
    display: block;
  }
  .work-item img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .work-item figcaption {
    padding: 12px 15px 14px;
    min-height: 74px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .work-t {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-weight: 600;
    color: #14140f;
    font-size: .98rem;
    line-height: 1.45;
  }
  .work-tag {
    display: block;
    font-size: .8rem;
    color: var(--muted);
    margin-top: 3px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
</style>