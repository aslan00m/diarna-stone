---
import { HEROES } from '../data/projects.js';
import { HOMEPAGE_WORKS } from '../data/projects-home.js';
import { url } from '../data/urls.js';
import Base from '../layouts/Base.astro';
import PhotoPlaceholder from '../components/PhotoPlaceholder.astro';
import PRODUCTS from '../data/products.js';
import { CATEGORIES, ORIGINS, LINKS, COMPANY } from '../data/company.js';
import { categoryLabel, CATEGORY_COVER } from '../data/counts.js';
import ProductCard from '../components/ProductCard.astro';
import { PARTNERS } from '../data/partners.js';

const usedOrigins = ORIGINS.filter((o) => PRODUCTS.some((p) => p.origin === o.slug));
const originCounts = Object.fromEntries(
  usedOrigins.map((o) => [o.slug, PRODUCTS.filter((p) => p.origin === o.slug).length])
);
// الأحجار الأكثر طلباً في المدينة المنورة — تظهر أولاً في الصفحة الرئيسية
const MEDINA_TOP_SLUGS = [
  'crema-marfil-classic',       // حجر الرياض الطبيعي (الأكثر استخداماً)
  'bianco-carrara-marble',       // حجر الرياض الأبيض
  'roman-travertine-classic',    // رخام ترافرتين
  'emperador-light-marble',      // الرخام العماني
  'basalt-dark',                 // بازلت المدينة
  'mugla-bianco-classic',        // رخام تركي (موغلا)
  'calacatta-marble',            // رخام إيطالي (كرارا/كالاكاتا)
  'statuario-marble',            // رخام إيطالي (ستاتواريو)
];
const MEDINA_TOP_NAMES = {
  'crema-marfil-classic': 'حجر الرياض الطبيعي (كريما مارفيل)',
  'bianco-carrara-marble': 'حجر الرياض الأبيض (بيانكو كرارة)',
  'roman-travertine-classic': 'رخام ترافرتين روماني',
  'emperador-light-marble': 'الرخام العماني (إمبرادور لايت)',
  'basalt-dark': 'بازلت المدينة',
  'mugla-bianco-classic': 'رخام موغلا التركي',
  'calacatta-marble': 'رخام كالاكاتا الإيطالي',
  'statuario-marble': 'رخام ستاتواريو الإيطالي',
};
const medinaTop = MEDINA_TOP_SLUGS
  .map((slug) => {
    const p = PRODUCTS.find((x) => x.slug === slug);
    if (p) p.name = MEDINA_TOP_NAMES[slug];
    return p;
  })
  .filter(Boolean);

const featured = PRODUCTS.slice(0, 8);
const newest = [...PRODUCTS].slice(-6).reverse();
const luxury = PRODUCTS.filter((p) => ['bianco-carrara-marble', 'buccino-italian-marble', 'cipollino-italian-marble', 'roman-travertine'].includes(p.slug));
const counts = {
  marble: PRODUCTS.filter((p) => p.category === 'marble').length,
  granite: PRODUCTS.filter((p) => p.category === 'granite').length,
  travertine: PRODUCTS.filter((p) => p.category === 'travertine').length,
  limestone: PRODUCTS.filter((p) => p.category === 'limestone').length,
};
---

<Base>
  <!-- HERO: الصور أولاً بملء العرض، ثم النص تحتها -->
  <div class="hero has-photo" id="hero">
    <div class="hero-media">
      <div class="hero-slides reveal-mask" aria-hidden="true" data-parallax="0.10">
        {HEROES.map((h, i) => (
          <img
            class={`hero-slide${i === 0 ? ' is-active' : ''}`}
            src={url(h.src)}
            alt=""
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            data-hero-alt={h.alt}
          />
        ))}
      </div>
      <div class="hero-dots" role="presentation">
        {HEROES.map((_, i) => (
          <span class={`hero-dot${i === 0 ? ' is-on' : ''}`} data-i={i}></span>
        ))}
      </div>
    </div>

    <div class="hero-body">
      <div class="wrap">
        <span class="eyebrow">ديارنا الحديثة — الرياض</span>
        <h1 class="line-reveal"><span>رخام وجحر طبيعي</span><span>بجودة تدوم طويلاً</span></h1>
        <p class="lead">
          {COMPANY.name} — تجارة الرخام والجرانيت والترافرتينو وتركيب الواجهات والأرضيات.
          نختار لك خامات تدوم أكثر من عمر المبنى.
        </p>
        <div class="hero-actions">
          <a href={url("/products")} class="btn">تصفّح المنتجات</a>
          <a href={LINKS.whatsapp} class="btn ghost">اطلب عرض سعر</a>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var slides = document.querySelectorAll('#hero .hero-slide');
      var dots = document.querySelectorAll('#hero .hero-dot');
      if (slides.length < 2) return;
      var i = 0, t = null;
      function show(n) {
        i = (n + slides.length) % slides.length;
        slides.forEach(function (s, k) { s.classList.toggle('is-active', k === i); });
        dots.forEach(function (d, k) { d.classList.toggle('is-on', k === i); });
      }
      function play() { t = setInterval(function () { show(i + 1); }, 6000); }
      play();
      dots.forEach(function (d) {
        d.addEventListener('click', function () {
          show(parseInt(d.getAttribute('data-i'), 10));
          clearInterval(t); play();
        });
      });
      var hero = document.getElementById('hero');
      hero.addEventListener('mouseenter', function () { clearInterval(t); });
      hero.addEventListener('mouseleave', play);
    })();
  </script>

  <!-- شريط المزايا -->
  <div class="strip">
    <div class="wrap">
      <div class="strip-grid" data-stagger>
        <div><strong class="num" data-count={PRODUCTS.length} data-suffix="+">{PRODUCTS.length}+</strong><span>نوع حجر</span></div>
        <div><strong class="num" data-count={6} data-suffix="">6</strong><span>مصادر عالمية</span></div>
        <div><strong class="num" data-count={10} data-suffix="+">10+</strong><span>سنوات خبرة</span></div>
        <div><strong class="num" data-count={100} data-suffix="%">100%</strong><span>ضمان جودة</span></div>
      </div>
    </div>
  </div>

  <!-- التصنيف حسب النوع -->
  <section>
    <div class="wrap">
      <h2 class="sec-title" data-anim="up">تصفّح حسب النوع</h2>
      <p class="sec-sub">ست فئات تغطي معظم احتياجات المشاريع السكنية والتجارية.</p>
      <div class="grid" data-stagger>
        {CATEGORIES.map((c) => {
          const cover = CATEGORY_COVER[c.slug];
          return (
            <a href={url(`/products/${c.slug}`)} class="card">
              <div style="aspect-ratio:4/3;overflow:hidden;background:#f8fafc">
                {cover ? (
                  <img
                    src={url(cover)}
                    alt={c.name}
                    style="width:100%;height:100%;object-fit:cover;display:block"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="ph" style="width:100%;height:100%;display:grid;place-items:center">
                    <span class="ico">{c.icon}</span>
                    <span>{c.name}</span>
                  </div>
                )}
              </div>
              <div class="card-body">
                <h3>{c.name}</h3>
                <div class="meta">{categoryLabel(c.slug)}</div>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- التصنيف حسب المصدر -->
  <section>
    <div class="wrap">
      <h2 class="sec-title" data-anim="up">تصفّح حسب المصدر</h2>
      <p class="sec-sub">خامات من أفضل مصانع العالم، مع إمكانية التوريد بكميات الجملة.</p>
      <div class="tabs">
        {usedOrigins.map((o) => (
          <a class="tab" href={url(`/origins/${o.slug}`)}>
            <span class="tab-flag">{o.flag}</span>
            <span class="tab-name">{o.name}</span>
            <span class="tab-count">{originCounts[o.slug]}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- الأكثر طلباً في المدينة المنورة -->
  <section>
    <div class="wrap">
      <h2 class="sec-title" data-anim="up">الأكثر طلباً في المدينة المنورة</h2>
      <p class="sec-sub">الأحجار الطبيعية الأكثر بيعًا واستخدامًا في واجهات المباني بالمدينة المنورة.</p>
      <div class="grid" data-stagger>
        {medinaTop.map((p) => <ProductCard product={p} />)}
      </div>
      <div style="text-align:center;margin-top:30px">
        <a href={url('/products')} class="btn">شاهد كل المنتجات</a>
      </div>
    </div>
  </section>

  <!-- منتجات مميزة -->
  <section>
    <div class="wrap">
      <h2 class="sec-title" data-anim="up">منتجات مميزة</h2>
      <p class="sec-sub">اختياراتنا الأكثر طلباً هذا الموسم.</p>
      <div class="grid" data-stagger>
        {featured.map((p) => <ProductCard product={p} />)}
      </div>
      <div style="text-align:center;margin-top:30px">
        <a href={url('/products')} class="btn">شاهد كل المنتجات</a>
      </div>
    </div>
  </section>

  <!-- أحدث المنتجات -->
  <section>
    <div class="wrap">
      <h2 class="sec-title" data-anim="up">أحدث المنتجات</h2>
      <p class="sec-sub">خامات أضفناها مؤخراً إلى المتجر.</p>
      <div class="grid" data-stagger>
        {newest.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- منتجات فاخرة -->
  {
    luxury.length > 0 && (
      <section>
        <div class="wrap">
          <h2 class="sec-title" data-anim="up">منتجات فاخرة</h2>
          <p class="sec-sub">رخام إيطالي مختار للمشاريع التي لا تقبل التنازل.</p>
          <div class="grid" data-stagger>
            {luxury.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- خدمات التركيب -->
  <section>
    <div class="wrap">
      <h2 class="sec-title" data-anim="up">خدمات التركيب والتنفيذ</h2>
      <p class="sec-sub">لا نبيع الحجر فحسب — نوفّر فريق التنفيذ الذي يحوّل التصميم إلى واقع.</p>
      <div class="grid" data-stagger>
        {[
          { i: '▤', t: 'تركيب الواجهات', d: 'تركيب حجر الجدران الخارجية بأسلوب دقيق يحافظ على استقامة السطح والتعامل مع النهايات والزوايا.' },
          { i: '▦', t: 'تركيب الأرضيات', d: 'أرضيات داخلية وخارجية بمسافات متناسقة ومعالجة كاملة للحواف.' },
          { i: '◈', t: 'تركيب الدرج', d: 'درج داخلي وخارجي بخطوات دقيقة المقطع وتناسق في الارتفاعات.' },
          { i: '▨', t: 'طاولات ومغاسل', d: 'قطع مخصصة حسب المقاسات مع حواف مصقولة وتنظيف نهائي قبل التسليم.' },
        ].map((s) => (
          <div class="card">
            <div class="card-body">
              <div class="ico-lg">{s.i}</div>
              <h3>{s.t}</h3>
              <p style="color:var(--muted);font-size:.93rem;margin:0">{s.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- لماذا نحن -->
  <section>
    <div class="wrap">
      <h2 class="sec-title">لماذا تختار ديارنا الحديثة؟</h2>
      <p class="sec-sub">أربعة أسباب تجعلنا الخيار الأول للعمّال والمصمّمين.</p>
      <div class="grid">
        {[
          { t: 'خبرة ميدانية', d: 'سنوات من التنفيذ الفعلي في مشاريع سكنية وتجارية، نعرف الفرق بين النظرية والممارسة.' },
          { t: 'خامات مختارة', d: 'نختار فقط ما نضمن جودته في الاستخدام الفعلي، ولا نبيع ما لا نستخدمه بأنفسنا.' },
          { t: 'تنفيذ كامل', d: 'من التوريد إلى التركيب النهائي تحت مسؤوليتنا — لا تحتاج للتنقّل بين موردين.' },
          { t: 'استشارة صادقة', d: 'ننصح بما يناسب مشروعك فعلاً، حتى لو كان الخيار الأرخص هو الأنسب لك.' },
        ].map((v) => (
          <div class="card">
            <div class="card-body">
              <h3>{v.t}</h3>
              <p style="color:var(--muted);font-size:.93rem;margin:0">{v.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- مشاريعنا -->
  <section id="works">
    <div class="wrap">
      <h2 class="sec-title">مشاريعنا</h2>
      <p class="sec-sub">
        صور حقيقية من مشاريع نفّذناها: واجهات خارجية، تشطيبات كلاسيكية، وأعمال قيد التنفيذ.
      </p>

      <div class="home-works-grid">
        {HOMEPAGE_WORKS.map((pr) => (
          <a href={url(`/works/${pr.slug}`)} class="work-item">
            <span class="shot"><img src={url(pr.cover)} alt={pr.coverAlt} loading="lazy" decoding="async" /></span>
            <figcaption>
              <span class="work-t">{pr.title}</span>
              <span class="work-tag">{pr.category}</span>
            </figcaption>
          </a>
        ))}
      </div>
      <div class="cta-row" style="margin-top:26px;justify-content:center">
        <a href={url('/works')} class="btn ghost">تصفح باقي مشاريعنا</a>
      </div>
    </div>
  </section>

  <!-- شركاؤنا -->
  <section>
    <div class="wrap">
      <h2 class="sec-title">شركاؤنا</h2>
      <p class="sec-sub">
        نعمل مع شبكة من الموردين والمصنّعين والمقاولين في المملكة، ونشاركهم المعايير نفسها:
        دقة في القطع، ووضوح في التعامل، واحترام الموعد.
      </p>

      <div class="partners-grid" data-stagger>
        {PARTNERS.map((p) => (
          <div class="partner">
            <img src={url(p.image)} alt={p.name} loading="lazy" decoding="async" />
            <span>{p.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <div class="wrap">
    <div class="cta">
      <h3>جاهزون لعرض سعر مشروعك</h3>
      <p>أرسل لنا نوع الحجر والمقاسات المطلوبة، ونرد خلال ساعات العمل.</p>
      <a href={url("/contact")} class="btn">طلب عرض سعر</a>
      <a href={LINKS.phone} class="btn" style="background:#14151a;color:#c9a227;margin-right:10px">اتصل الآن</a>
    </div>
  </div>
</Base>