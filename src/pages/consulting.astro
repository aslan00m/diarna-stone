---
import { url } from '../data/urls.js';
import Base from '../layouts/Base.astro';
import { COMPANY, LINKS } from '../data/company.js';
---

<Base title="الاستشارات" description="استشارات حجر مجانية لاختيار الخامة والتصميم والتركيب.">
  <section>
    <div class="wrap">
      <div class="crumbs"><a href={url('/')}>الرئيسية</a> / الاستشارات</div>
      <h1 class="sec-title">الاستشارات</h1>
      <p class="sec-sub">
        اختيار الحجر قرار يستمر سنوات. استشارة مجانية من فريق يعرف الفروق الفعلية
        بين الخامات، ويوفّر عليك تكلفة تجربة وخطأ.
      </p>
    </div>
  </section>

  <!-- ما تقدمه الاستشارة -->
  <section>
    <div class="wrap">
      <h2 class="sec-title">ماذا تشمل الاستشارة؟</h2>
      <p class="sec-sub">أربع محاور نغطيها في كل استشارة، حسب طبيعة مشروعك.</p>
      <div class="grid">
        {[
          {
            i: '◈',
            t: 'اختيار الخامة',
            d: 'نراجع استخدامك المتوقّع — أرضيات أم واجهات أم مطبخ — ونقترح الخامات التي تتحمّل هذا الاستخدام فعلاً، مع بيان التكلفة التقريبية لكل خيار.',
          },
          {
            i: '▦',
            t: 'التصميم والتوزيع',
            d: 'نراجع المقاسات والفتات ونقترح توزيعاً يوفّر الهدر: كم لوحاً تحتاج لكل جدار، وأين تتكرر العروق، وكيف يتغير اللون بين اللوحات.',
          },
          {
            i: '▤',
            t: 'التشطيب والتركيب',
            d: 'نحدد نوع التشطيب المناسب حسب الموقع — مصقول للمطابخ، مطفأ للأرضيات الداخلية، معالجة خارجية للواجهات — مع تنبيهك للفرق في الصيانة.',
          },
          {
            i: '▨',
            t: 'الميزانية والتوريد',
            d: 'نقارن بين بدائل بميزانيات مختلفة ونشرح الفرق العملي بينها، ونخبرك بما يمكن تأجيله دون أن يتأثر شكل المشروع النهائي.',
          },
        ].map((s) => (
          <div class="card">
            <div class="card-body">
              <div class="ico-lg">{s.i}</div>
              <h3>{s.t}</h3>
              <p style="color:var(--muted);font-size:.93rem;margin:0">{s.d}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- متى تحتاج استشارة -->
  <section>
    <div class="wrap">
      <h2 class="sec-title">متى تحتاج استشارة قبل الشراء؟</h2>
      <p class="sec-sub">هذه الحالات التي أغلبها يكلّف العميل مالاً حقيقياً إن أُخطئ فيها.</p>
      <div class="prose">
        <p>
          أول ما نحتاج فيه مشورة هو <strong>الواجهات الكبيرة</strong>. الواجهة هنا مساحة
          واحدة ممتدة، وعند تركيبها بألواح عشوائية تظهر فروق اللون بين اللوحات بشكل واضح.
          التركيب الاقتصادي يتطلب تخطيطاً يوزّع العروق والبقيع على السطح كاملاً، وهذا يحتاج
          معاينة قبل التوريد لا بعده.
        </p>
        <p>
          ثانياً <strong>المطابخ</strong>. السطح هنا أعلى تعرّضاً للخدش والحرارة والمواد الحمضية،
          والاختيار بين الرخام والجرانيت هنا ليس ذوقاً بل قرار عملي. الجرانيت يتحمّل
          الاستخدام اليومي لعشرات السنين، والرخام أجمل في الديكور لكنه يحتاج عناية أكبر.
          نقول لك الحقيقة في الحالتين.
        </p>
        <p>
          ثالثاً <strong>الأرضيات في الحمامات</strong>. الخطر الأساسي هنا ليس الخدش بل
          الانزلاق، خصوصاً مع التشطيب المصقول على أرضية مبللة. نقترح السماكة والتشطيب
          المناسبين، ونشرح سبب اختيار كل منها.
        </p>
        <p>
          رابعاً <strong>المشاريع ذات الكميات الكبيرة</strong>. هنا ترد في التوريد وعند
          التركيب، وفهم التوزيع قبل البدء يوفّر أسابيع من التأخير. نراجع الرسومات
          ونحسب الكمية الفعلية مع هامش معقول.
        </p>
      </div>
    </div>
  </section>

  <!-- كيف تسير الجلسة -->
  <section>
    <div class="wrap">
      <h2 class="sec-title">كيف تسير الجلسة؟</h2>
      <p class="sec-sub">ثلاث خطوات، لا تستغرق أكثر من يوم عمل.</p>
      <ol class="steps">
        <li>
          <strong>إرسال التفاصيل</strong>
          <p>
            أرسل لنا نوع المشروع (سكني/تجاري)، الاستخدام المطلوب (أرضيات/واجهات/مطبخ)،
            المساحة التقريبية، وموقع المشروع. formulario موجود في صفحة
            <a href={url('/contact')}>طلب عرض السعر</a>.
          </p>
        </li>
        <li>
          <strong>دراسة وإجابة</strong>
          <p>
            يراجع فريقنا الطلب ويرتب لك قائمة خيارات مع ملاحظات قصيرة عن كل خيار:
            المميزات، التحذيرات، وفارق السعر. تصلك خلال ساعات العمل.
          </p>
        </li>
        <li>
          <strong>معاينة قبل الشراء</strong>
          <p>
            في المشاريع الكبيرة نرتب معاينة ميدانية على الموقع لوضع العينات على الأرض ورفقها في الإضاءة الحقيقية — لأن شكل الحجر يتغير تماماً بين ضوء
            النهار والإضاءة الداخلية.
          </p>
        </li>
      </ol>
    </div>
  </section>

  <div class="wrap">
    <div class="cta">
      <h3>ابدأ استشارتك المجانية</h3>
      <p>لا توجد رسوم على الاستشارة الأولى، ولا التزام بالشراء بعدها.</p>
      <a href={url('/contact')} class="btn">طلب استشارة</a>
      <a href={LINKS.phone} class="btn cta-dark">اتصل {COMPANY.phone}</a>
    </div>
  </div>
</Base>