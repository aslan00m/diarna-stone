---
import Base from '../layouts/Base.astro';
import { COMPANY, CATEGORIES, LINKS } from '../data/company.js';
---

<Base title="خدمات التركيب" description="تركيب الواجهات والأرضيات والدرج باحترافية عالية.">
  <section>
    <div class="wrap">
      <div class="crumbs"><a href="/">الرئيسية</a> / خدمات التركيب</div>
      <h1 class="sec-title">خدمات التركيب والتنفيذ</h1>
      <p class="sec-sub">
        لا نبيع الحجر فحسب — نوفر فريق التنفيذ الذي يحوّل التصميم إلى واقع.
        خبرة ميدانية في تركيب الواجهات والأرضيات والدرج في مشاريع سكنية وتجارية.
      </p>

      <div class="grid">
        {[
          { t: 'تركيب الواجهات', d: 'تركيب حجر الجدران الخارجية بأسلوب دقيق يحافظ على استقامة السطح ويتعامل مع النهايات والزوايا بشكل احترافي.' },
          { t: 'تركيب الأرضيات', d: 'أرضيات داخلية وخارجية بمسافات متناسقة ومعالجة كاملة للحواف، مع مراعاة حركة البلاط تحت الحرارة.' },
          { t: 'تركيب الدرج', d: 'درج داخلي وخارجي بخطوات دقيقة المَقطع، مع تناسق الارتفاعات بين كل درجة والتي تليها.' },
          { t: 'أسطح الطاولات والمغاسل', d: 'قطع مخصصة حسب المقاسات المطلوبة مع حواف مصقولة وتنظيف نهائي قبل التسليم.' },
        ].map((s) => (
          <div class="card">
            <div class="card-body">
              <h3>{s.t}</h3>
              <p style="color:var(--muted);font-size:.93rem;margin:0">{s.d}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="cta">
        <h3>نجهّز لك عرض سعر كامل</h3>
        <p>الحجر + التوريد + التركيب — كله في عرض واحد.</p>
        <a href="/contact" class="btn">اطلب عرض سعر</a>
        <a href={LINKS.phone} class="btn" style="background:#14151a;color:#c9a227;margin-right:10px">
          {COMPANY.phone}
        </a>
      </div>
    </div>
  </section>
</Base>