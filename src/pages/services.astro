---
import { url } from '../data/urls.js';
import Base from '../layouts/Base.astro';
import { COMPANY, CATEGORIES, LINKS } from '../data/company.js';
import ABOUT_CARDS from '../data/about-cards.js';
---

<Base title="خدمات التركيب" description="تركيب الواجهات والأرضيات والدرج باحترافية عالية.">
  <section>
    <div class="wrap">
      <div class="crumbs"><a href={url("/")}>الرئيسية</a> / خدمات التركيب</div>
      <h1 class="sec-title">خدمات التركيب والتنفيذ</h1>
      <p class="sec-sub">
        لا نبيع الحجر فحسب — نوفر فريق التنفيذ الذي يحوّل التصميم إلى واقع.
        خبرة ميدانية في تركيب الواجهات والأرضيات والدرج في مشاريع سكنية وتجارية.
      </p>

      <div class="grid">
        {[
          { slug: 'exterior-facades', t: 'تركيب الواجهات', d: 'تركيب حجر الجدران الخارجية بأسلوب دقيق يحافظ على استقامة السطح ويتعامل مع النهايات والزوايا بشكل احترافي.' },
          { slug: 'interior-floors', t: 'تركيب الأرضيات', d: 'أرضيات داخلية وخارجية بمسافات متناسقة ومعالجة كاملة للحواف، مع مراعاة حركة البلاط تحت الحرارة.' },
          { slug: 'stairs-steps', t: 'تركيب الدرج', d: 'درج داخلي وخارجي بخطوات دقيقة المقطع، مع تناسق الارتفاعات بين كل درجة والتي تليها.' },
          { slug: 'stone-sinks', t: 'أسطح الطاولات والمغاسل', d: 'قطع مخصصة حسب المقاسات المطلوبة مع حواف مصقولة وتنظيف نهائي قبل التسليم.' },
        ].map((s) => (
          <a href={url(`/about/${s.slug}`)} class="card" style="text-decoration:none">
            <div class="card-body">
              <h3>{s.t}</h3>
              <p style="color:var(--muted);font-size:.93rem;margin:0">{s.d}</p>
              <span style="display:inline-block;margin-top:10px;color:var(--gold);font-size:.9rem">
                اعرف التفاصيل ←
              </span>
            </div>
          </a>
        ))}
      </div>

      <h2 class="sec-title" style="margin-top:48px">تفاصيل كل خدمة</h2>
      <p class="sec-sub">لكل خدمة صفحتها الخاصة مع الشرح الكامل لما ينفّذ بالضبط.</p>
      <div class="grid" style="margin-top:22px">
        {ABOUT_CARDS.map((c) => (
          <a href={url(`/about/${c.slug}`)} class="card" style="text-decoration:none">
            <div class="card-body">
              <h3>{c.icon} {c.title}</h3>
              <p style="color:var(--muted);font-size:.93rem;margin:0">{c.excerpt}</p>
              <span style="display:inline-block;margin-top:10px;color:var(--gold);font-size:.9rem">
                اعرف التفاصيل ←
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="cta">
        <h3>نجهّز لك عرض سعر كامل</h3>
        <p>الحجر + التوريد + التركيب — كله في عرض واحد.</p>
        <a href={url("/contact")} class="btn">اطلب عرض سعر</a>
        <a href={LINKS.phone} class="btn" style="background:#14151a;color:#c9a227;margin-right:10px">
          {COMPANY.phone}
        </a>
      </div>
    </div>
  </section>
</Base>