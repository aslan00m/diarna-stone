---
import { url } from '../../data/urls.js';
import Base from '../../layouts/Base.astro';
import POSTS from '../../data/blog.js';
import PRODUCTS from '../../data/products.js';
import ProductCard from '../../components/ProductCard.astro';
import { graph, article as articleSchema, faq as faqSchema, breadcrumb } from '../../data/schema.js';

export function getStaticPaths() {
  return POSTS.map((p) => ({ params: { slug: p.slug }, props: { post: p } }));
}

const { post } = Astro.props;
const others = POSTS.filter((p) => p.slug !== post?.slug).slice(0, 3);
// Related products: only slugs that actually exist in the catalogue, so a
// removed product can never render a dead card or a 404 link.
const related = (post?.related || [])
  .map((s) => PRODUCTS.find((p) => p.slug === s))
  .filter(Boolean);

const fmt = (d) =>
  new Date(d).toLocaleDateString('ar-SA', { year: 'numeric', month: 'long', day: 'numeric' });

// Word count drives the Article node's wordCount, and it is what proves the
// article is not a stub. Counted from the rendered prose, not the source.
const words = post.sections.reduce(
  (n, s) => n + s.p.join(' ').split(/\s+/).filter(Boolean).length,
  0
);

const path = `/blog/${post.slug}`;
const schemaJson = graph([
  articleSchema({
    title: post.title,
    description: post.excerpt,
    path,
    datePublished: post.date,
    image: post.image,
    section: post.category,
    wordCount: words,
  }),
  faqSchema(post.faq),
  breadcrumb([
    { name: 'الرئيسية', path: '/' },
    { name: 'مدونتنا', path: '/blog' },
    { name: post.title, path },
  ]),
]);
---

<Base
  title={post.title}
  description={post.excerpt}
  image={post.image}
  canonical={path}
  schema={schemaJson}
  type="article"
>
  <section>
    <div class="wrap">
      <div class="crumbs"><a href={url('/')}>الرئيسية</a> / <a href={url('/blog')}>مدونتنا</a> / {post.title}</div>

      <div class="post-head">
        <span class="pill">{post.category}</span>
        <h1 class="sec-title">{post.title}</h1>
        <p class="post-meta">{fmt(post.date)} · قراءة {post.readTime}</p>
        <p class="lead">{post.excerpt}</p>
        {post.image && (
          <img
            src={url(post.image)}
            alt={post.imageAlt || post.title}
            style="width:100%;height:auto;border-radius:14px;margin-top:18px"
            loading="eager"
            decoding="async"
          />
        )}
      </div>

      <article class="prose">
        {post.sections.map((s) => (
          <>
            <h2>{s.h}</h2>
            {s.p.map((para) => <p>{para}</p>)}
          </>
        ))}

        <h2>الأسئلة الشائعة</h2>
        {post.faq.map((f) => (
          <details class="faq">
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}

        {related.length > 0 && (
          <div class="post-related">
            <h2>أحجار من المعرض تناسب هذا المقال</h2>
            <div class="grid" data-stagger>
              {related.map((p) => <ProductCard product={p} />)}
            </div>
          </div>
        )}

        <div class="post-cta">
          <h3>محتاج مساعدة في اختيار الخامة؟</h3>
          <p>فريقنا يراجع استخدامك ويقترح الأنسب ضمن ميزانيتك.</p>
          <a href={url('/contact')} class="btn">تحدث مع مختص</a>
          <a href={url('/consulting')} class="btn ghost">استشارة مجانية</a>
        </div>
      </article>

      <div style="margin-top:56px">
        <h2 class="sec-title">مقالات أخرى</h2>
        <div class="grid">
          {others.map((o) => (
            <a href={url(`/blog/${o.slug}`)} class="card">
              <div class="card-body">
                <span class="pill">{o.category}</span>
                <h3 style="margin-top:8px">{o.title}</h3>
                <div class="meta">{fmt(o.date)} · {o.readTime}</div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
</Base>