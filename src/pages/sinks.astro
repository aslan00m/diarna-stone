---
import { url } from '../data/urls.js';
import Base from '../layouts/Base.astro';
import { LINKS } from '../data/company.js';
import PRODUCTS from '../data/products.js';
import ProductCard from '../components/ProductCard.astro';
---

<Base
  title="المغاسل الحجرية"
  description="مغاسل رخام وجرانيت وترا فرتينو مصنوعة من الحجر الطبيعي — الأنواع، الخامات، المقاسات، والتركيب. ديارنا الحديثة."
>
  <section>
    <div class="wrap">
      <div class="crumbs"><a href={url('/')}>الرئيسية</a> / المغاسل الحجرية</div>

      <div class="hero">
        <h1>المغاسل الحجرية</h1>
        <p class="lead">
          المغسلة الحجرية ليست قطعة صحية فحسب، بل عنصر معماري يشبه منحوتة. تُنحت من كتلة
          حجر طبيعي صلب، فتحتفظ بعروقه ولونه ووزنه الحقيقي — ولهذا تختلف كل قطعة عن أختها.
          نوفّرها بأشكال ومقاسات مختلفة، ونركّبها في الرياض.
        </p>
      </div>

      <div class="prose">
        <h2>لماذا المغسلة الحجرية؟</h2>
        <p>
          المغسلة الخزفية تنتج القطع كلها متشابهة: نفس الشكل، نفس اللون، نفس الوزن. المغسلة
          الحجرية تفعل العكس تماماً — اختلاف العروق بين اللوحين يعني أن مغسلتين من نفس المحجر تبدوان
          مختلفتين. هذا التباين هو ما يجعلها عنصراً بصرياً في الحمام لا مجرد أداة.
        </p>
        <p>
          وزنها هنا ميزة لا عيب. المغسلة الحجرية أثقل بكثير من الخزفية، وهذا ما يمنع
          اهتزازها على سطح الطاولة عند تشغيل الماء، ويعطي إحساساً بالثبات عند الاستخدام. لكن
          هذا الوزن نفسه يفرض شرطاً: القاعدة تحته يجب أن تحمله فعلاً.
        </p>

        <h2>الأنواع الرئيسية</h2>
        <h3>المغسلة السطحية (Vessel)</h3>
        <p>
          تقع فوق البلاطة ويظهر شكلها كاملاً كحوض مستدير أو بيضوي. هي الأكثر
          إبهاراً بصرياً وتُستخدم في الحمامات الفاخرة وغرف الضيوف. تحتاج خلاطاً طويلاً
          (داخل الطاولة أو جدارياً) لأن حافتها أعلى من سطح البلاطة.
        </p>

        <h3>المغسلة المدمجة (Undermount)</h3>
        <p>
          تُثبَّت أسفل سطح البلاطة الرخامية بحيث يظهر الحوض وحده، فلا يوجد أي حافة تعبّر عن
          التركيب. النتيجة سطح حجري متصل من الحدّ إلى الحوض بلا فاصل. هي الأنسب للمطابخ
          وحمامات الفنادق، والأنظف بصرياً.
        </p>

        <h3>المغسلة الحائطية</h3>
        <p>
          تُعلَّق مباشرة على الجدار بلا وحدة تحت منها. توفّر مساحة الأرضية بالكامل وتناسب الحمامات
          الصغيرة والأجنحة الخاصة. تحتاج تثبيتاً قوياً في الجدار لأن كل الوزن محمّل على الحائط.
        </p>

        <h3>المغسلة المزدوجة (Trough)</h3>
        <p>
          حوض مستطيل طويل يتّسع لمغسلين. تُستخدم في غرف النوم master في الفنادق والمنازل
          الكبيرة. تحتاج بلاطة أعرض بوضوح، وميزانية أكبر.
        </p>

        <h2>الأشكال الشائعة</h2>
        <ul>
          <li><strong>دائري</strong> — الكلاسيكي، يبرز لون وعروق الحجر بلا زوايا تحدّ من الفرد.</li>
          <li><strong>بيضوي</strong> — أطول قليلاً، يناسب البلاطات المستطيلة ويمنح إحساساً أضيق.</li>
          <li><strong>مستطيل / مربع</strong> — خطوط حديثة نظيفة، يناسب التصميم المعاصر والخلط مع خلاطات معمارية.</li>
          <li><strong>مقوّس (D-Shape)</strong> — ظهر مستقيم ومقدمة منحنية، يحافظ على استقامة التركيب مع لمسة دائرية.</li>
        </ul>

        <h2>الخامات: أيّهما يناسب أي حمام؟</h2>
        <ul>
          <li>
            <strong>رخام (كرارة، كالاكاتا، بيوتي)</strong> — الأكثر رواجاً. ناعم، فاتح، ذات عروق
            ظاهرة. يحتاج تنظيفاً محايداً وتجنّب الخل ومنظفات الليمون.
          </li>
          <li>
            <strong>جرانيت</strong> — الأكثر متانة. يتحمّل الاستخدام اليومي الشاق دون خدش
            أو تبقّع. اختيار عملي للمطابخ وحمامات الفنادق.
          </li>
          <li>
            <strong>ترا فرتينو</strong> — دافئ بألوانه الرملية، ومسامه تعطي حضوراً هادئاً. يحتاج
            عزلاً دورياً لأنه شديد المسامية.
          </li>
          <li>
            <strong>حجر جيري</strong> — ناعم الملمس، محايد اللون،مناسب للحمامات الهادئة. من أرخص
            الخيارات وأقلها بريقاً.
          </li>
          <li>
            <strong>أونيكس</strong> — نادر وشبه شفاف، يضيء من الداخل عند الإضاءة الخلفية. فخامة قصوى،
            وأقل صلابة، ويحتاج عناية مشددة.
          </li>
        </ul>

        <h2>قبل الطلب: ما الذي يجب معرفته؟</h2>
        <ul>
          <li>
            <strong>الوزن والقاعدة</strong> — المغسلة الحجرية قد تزن 15 إلى 40 كجم. القاعدة تحتها
            يجب أن تكون صلبة ومستوية، وإلا ظهرت اهتزازات أو تشوّه.
          </li>
          <li>
            <strong>الخلاط أولاً</strong> — اغسل مجرى الماء أولاً. ارتفاع الخلاط يجب أن يكون مناسباً لحافة
            الحوض. خلّط على ارتفاع الحوض.
          </li>
          <li>
            <strong>فتحة التصريف</strong> — أغلب المغالس الحجرية بلا فتحة overflow. تأكّد من
            قطر فتحة التصريف ونوع السدادة (مفتوح أم بنقرة) قبل التصنيع.
          </li>
          <li>
            <strong>المقاس</strong> — في الحمامات الضيقة اختر عرضاً لا يتجاوز 50 سم، وراعِ أن تبقى
            مساحة مريحة أمام الحوض وخلفيته للخلاط.
          </li>
          <li>
            <strong>الوقاية من الجير</strong> — في المناطق ذات الماء العسر، امسح الحوض وجفّفه
            بعد الاستخدام لمنع ترسّبات الجير.
          </li>
        </ul>

        <h2>العناية اليومية</h2>
        <p>
          التنظيف بماء دافئ وصابون محايد يكفي. لا تستخدم الخل أو منظفات الليمون أو مزيل الجير —
          فهي حمضية وتآكل سطح الرخام والترا فرتينوتآكل السطح الداخلي يعتم اللمعان. اشطف الحوض بعد
          كل استخدام وامسحه بقطعة قطنية جافة. يُنصح بإعادة العزل كل ستة إلى اثني عشر شهراً
          للخامات المسامية.
        </p>
        <p>
          نصيحة عملية: أي تسرّب امسحه فوراً ولا تتركه يجفّ، فالبقايا تجفّ وتصبغ. الشقوق الصغيرة تُملأ بحجر مطابق قبل أن تكبر وتصبح?</p>

        <div class="post-cta">
          <h3>تبحث عن مغسلة مخصصة؟</h3>
          <p>أرسل لنا المقاس والشكل والخامة المطلوبة — نوفّرها ونركّبها.</p>
          <a href={LINKS.whatsapp} class="btn">اطلب عبر واتساب</a>
          <a href={url('/contact')} class="btn ghost">نموذج طلب كامل</a>
        </div>
      </div>
    </div>
  </section>
  <section>
    <div class="wrap">
      <h2 class="sec-title">أنواع المغاسل المتوفرة</h2>
      <p class="sec-sub">اضغط على أي مغسلة لعرض تفاصيلها والخامة والمقاسات.</p>
      <div class="grid" style="margin-top:22px">
        {PRODUCTS.filter((p) => p.category === 'sinks').map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

</Base>