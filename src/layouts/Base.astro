---
import { url } from '../data/urls.js';
import { COMPANY, LINKS } from '../data/company.js';
import '../styles/global.css';

const { title, description } = Astro.props;
const pageTitle = title ? `${title} | ${COMPANY.name}` : `${COMPANY.name} — ${COMPANY.tagline}`;
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description || COMPANY.description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description || COMPANY.description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ar_SA" />
    <link rel="icon" href={url("/favicon.svg")} type="image/svg+xml" />
  </head>
  <body>
    <header class="top">
      <div class="wrap">
        <a href={url("/")} class="brand">ديارنا <span>الحديثة</span></a>
        <nav class="top-nav">
          <a href={url("/products")}>المنتجات</a>
          <a href={url("/services")}>خدمات التركيب</a>
          <a href={url("/about")}>عن الشركة</a>
          <a href={url("/contact")}>طلب عرض سعر</a>
        </nav>
        <a href={LINKS.phone} class="btn">{COMPANY.phone}</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="bot">
      <div class="wrap">
        <div>
          <strong>{COMPANY.name}</strong><br />
          {COMPANY.tagline}
        </div>
        <div>
          هاتف: <a href={LINKS.phone}>{COMPANY.phone}</a><br />
          واتساب: <a href={LINKS.whatsapp}>تواصل الآن</a>
        </div>
        <div>
          {COMPANY.city}<br />
          {COMPANY.hours}
        </div>
      </div>
    </footer>
  </body>
</html>