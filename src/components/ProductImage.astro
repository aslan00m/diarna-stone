---
import { url } from '../data/urls.js';

const { product, large = false } = Astro.props;
const isPlaceholder = !product.image;
---

<div class={`ph ${large ? 'ph-large' : ''}`}>
  {
    isPlaceholder ? (
      <>
        <span class="ico">▧</span>
        <span>تحت البحث عن صورة</span>
      </>
    ) : (
      <img src={url(product.image)} alt={`${product.name} - ${product.nameEn}`} loading={large ? 'eager' : 'lazy'} decoding="async" />
    )
  }
</div>