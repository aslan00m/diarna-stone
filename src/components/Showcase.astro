---
import { url } from '../data/urls.js';
// معرض صور عامة — نفس الصور تظهر في أكثر من صفحة عمداً
const IMGS = [
  { src: '/images/heroes/hero-1-villa-evening.jpg', alt: 'فيلا حديثة بواجهة داكنة وإضاءة مسائية' },
  { src: '/images/heroes/hero-2-villa-pool.jpg', alt: 'فيلا بيضاء بمسبح خارجي وحدائق' },
  { src: '/images/heroes/hero-3-villa-pool-2.jpg', alt: 'مسبح فيروزي وشرفات زجاجية' },
  { src: '/images/heroes/hero-4-villa-modern.jpg', alt: 'واجهة بيضاء وأسقف خشبية ومسبح طويل' },
];
const { title = 'من أعمالنا' } = Astro.props;
---

<section class="showcase">
  <div class="wrap">
    <h2 class="sec-title">{title}</h2>
    <p class="sec-sub">صور حقيقية من مشاريع نفّذها ديارنا الحديثة.</p>
    <div class="sc-grid">
      {IMGS.map((im) => (
        <figure class="sc-item">
          <img src={url(im.src)} alt={im.alt} loading="lazy" decoding="async" />
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .showcase { padding: 58px 0; }
  .sc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    gap: 14px;
    margin-top: 22px;
  }
  .sc-item {
    margin: 0;
    border-radius: 14px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: #fff;
  }
  .sc-item img { display: block; width: 100%; height: auto; }
</style>
