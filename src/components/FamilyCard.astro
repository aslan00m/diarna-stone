---
import { url } from '../data/urls.js';
import { CATEGORIES, ORIGINS } from '../data/company.js';
import ProductImage from './ProductImage.astro';

// One card per stone family: the stone's GENERAL name and ONE photo. A family is several
// grades of the same stone sharing a single photograph (verified byte-identical), so
// putting per-grade photos on the cards just repeats the same picture. The card links to
// the family's page, which lists every grade with its own colour in a table.
const { product, family } = Astro.props;

const cat = CATEGORIES.find((c) => c.slug === product.category);
const org = ORIGINS.find((o) => o.slug === product.origin);
const n = family?.count ?? 1;
---

<a
  href={family?.multi ? url(`/stones/${family.slug}`) : url(`/products/${product.slug}`)}
  class="card"
>
  <ProductImage product={product} />
  <div class="card-body">
    <h3>{family?.name ?? product.name}</h3>
    {product.nameEn && <div class="en">{product.nameEn}</div>}
    <div class="meta">
      {cat?.name} · {org?.name} — {product.color}
    </div>
    {family?.multi && <div class="types">{n} أنواع</div>}
  </div>
</a>

<style>
  .types {
    display: inline-block;
    margin-top: 8px;
    background: #f1f5f9;
    color: #334155;
    border-radius: 999px;
    padding: 3px 11px;
    font-size: .76rem;
  }
</style>